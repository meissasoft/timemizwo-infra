# ============================================================================
# LetsTrack — PRODUCTION environment template.
# Copy to `.env.production` ON THE SERVER and fill every REQUIRED value.
# NEVER commit .env.production — only this .example template is tracked.
#
# Two consumers read this file:
#   1) docker compose  — for ${...} interpolation (IMAGE_TAG, ports, passwords)
#   2) the app containers — via `env_file:` (JWT, S3 keys, SMTP, Stripe, …)
#
# NOTE: DATABASE_URL and REDIS_URL are intentionally NOT set here. Compose
# builds them from the parts below (see docker-compose.yml `environment:`),
# because env-file values do not expand nested ${VARS}.
#
# ALL secrets below MUST be freshly generated for production — do NOT reuse
# any value from staging/.env.staging (JWT_SECRET, INTEGRATION_ENCRYPTION_KEY,
# POSTGRES_PASSWORD, REDIS_PASSWORD, S3 keys — everything).
# ============================================================================

# ── Image / ports ───────────────────────────────────────────────────────────
IMAGE_TAG=v1.0.0
# Host loopback port our nginx binds to; the server's Apache forwards
# timemizwo.com -> 127.0.0.1:${PUBLIC_PORT}. Reserved block for prod: 9003/9004
# (staging owns 9001/9002 — do not reuse, they're on the same box).
PUBLIC_PORT=9003

# ── Postgres (container + DATABASE_URL parts) ────────────────────────────────
POSTGRES_USER=letstrack
POSTGRES_PASSWORD=            # REQUIRED — min 24 chars; avoid @ : / and spaces; FRESH, not staging's
POSTGRES_DB=letstrack

# ── Redis (container + REDIS_URL parts) ──────────────────────────────────────
REDIS_PASSWORD=              # REQUIRED — strong random; avoid @ : / and spaces; FRESH, not staging's
REDIS_KEY_PREFIX=mt-prod:

# ── S3 / MinIO ────────────────────────────────────────────────────────────────
S3_ACCESS_KEY=              # REQUIRED — becomes MINIO_ROOT_USER (min 3 chars)
S3_SECRET_KEY=              # REQUIRED — becomes MINIO_ROOT_PASSWORD (min 8 chars)
S3_BUCKET=letstrack-screenshots
# Public downloads bucket for the desktop agent app (installers / auto-update).
# minio-setup makes its `agent/` prefix anonymously readable (public GET).
DOWNLOADS_BUCKET=letstrack-downloads
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Public S3 endpoint — presigned upload/download URLs point here, so it MUST be
# reachable by the agent + browser. Front MinIO with the s3.<domain> vhost.
S3_ENDPOINT=https://s3.timemizwo.com

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=                 # REQUIRED — 64+ char random (min 32 enforced); FRESH, not staging's
JWT_ACCESS_TTL=900          # 15 min (seconds)
JWT_REFRESH_TTL=2592000     # 30 days (seconds)
MFA_ISSUER=Timemizwo

# ── Public URL (used inside email links: password reset, invitations) ────────
APP_URL=https://timemizwo.com

# ── CORS (comma-separated origins) ───────────────────────────────────────────
CORS_ORIGINS=https://timemizwo.com,https://www.timemizwo.com

# ── Email ──────────────────────────────────────────────────────────────────
# Production sends real email — 'smtp', not 'mock'.
EMAIL_PROVIDER=smtp
EMAIL_FROM=Timemizwo <noreply@timemizwo.com>
# Before go-live: add SPF + DKIM + DMARC DNS records for timemizwo.com in the
# email provider's (Brevo) dashboard, or mail lands in spam / gets rejected.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false      # true for port 465, false for 587 (STARTTLS)
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# ── Billing (Stripe) — LIVE keys only, sk_live_ / pk_live_ ───────────────────
# Run lets-track-api/scripts/setup-stripe-products.mjs against LIVE mode first
# (creates plans.stripe_price_id_* rows) or checkout returns BILLING_NOT_READY.
PLAN_ENFORCEMENT_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ─── AI Chat ────────────────────────────────────────────────────────────────
AI_MAX_TOKENS=

AI_FALLBACK_PROVIDER=-
AI_FALLBACK_MODEL=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
ANTHROPIC_API_KEY=

AI_ROUTING_ENABLED=true
AI_ROUTER_PROVIDER=openai-compatible
AI_ROUTER_MODEL=gemini-2.5-flash-lite
AI_ROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_ROUTER_API_KEY=

AI_COMPLEX_PROVIDER=openai-compatible
AI_COMPLEX_MODEL=gemini-3.1-flash-lite
AI_COMPLEX_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_COMPLEX_API_KEY=
CHAT_MAX_HISTORY_MESSAGES=6
AI_ROUTING_DEBUG=false

# ── Rate limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Observability (optional but recommended for prod) ────────────────────────
SENTRY_DSN=

# ── Client build-time public vars (baked into the JS bundle at build) ─────────
# Same-origin: the browser hits the same host that served the page. Changing any
# of these requires REBUILDING the client image.
NEXT_PUBLIC_API_URL=https://timemizwo.com/api
NEXT_PUBLIC_WS_URL=https://timemizwo.com
NEXT_PUBLIC_APP_URL=https://timemizwo.com
NEXT_PUBLIC_PRODUCT_NAME=Timemizwo
NEXT_PUBLIC_COMPANY_NAME=Meissasoft

# ── Backups (used by scripts/backup-prod.sh) ──────────────────────────────────
BACKUP_DIR=~/timenova-track/backups-prod
BACKUP_RETENTION_DAYS=30
# Off-site target for `rclone copy` — DB dumps only (screenshots stay local on
# MinIO for now; see SESSION_NOTES_DEPLOY.md). Configure the remote first:
#   rclone config   # create a remote named e.g. "awss3", type s3, provider AWS,
#                    # paste the IAM user's Access Key ID / Secret Access Key,
#                    # region = same as the bucket.
# Then:
BACKUP_REMOTE=awss3:letstrack-prod-backups

# ── Integrations ─────────────────────────────────────────────
INTEGRATION_ENCRYPTION_KEY=   # REQUIRED — 32 bytes: `openssl rand -base64 32`; FRESH, not staging's
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI=https://timemizwo.com/integrations/clickup/callback
CLICKUP_WEBHOOK_CALLBACK_URL=https://timemizwo.com/api/integrations/webhooks/clickup
TRELLO_API_KEY=
TRELLO_API_SECRET=
TRELLO_REDIRECT_URI=https://timemizwo.com/integrations/trello/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=https://timemizwo.com/integrations/jira/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=https://timemizwo.com/integrations/linear/callback
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
ASANA_REDIRECT_URI=https://timemizwo.com/integrations/asana/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://timemizwo.com/integrations/github/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://timemizwo.com/integrations/slack/callback
HUBSTAFF_CLIENT_ID=
HUBSTAFF_CLIENT_SECRET=
HUBSTAFF_REDIRECT_URI=https://timemizwo.com/integrations/hubstaff/callback
