# Add this to the SERVER's EXISTING Nginx (NOT our compose nginx).
# It terminates TLS for timenova.meissasoft.com and forwards to our stack on
# 127.0.0.1:9001.
#
#   sudo cp nginx-vhost.conf.example /etc/nginx/sites-available/timenova.conf
#   sudo ln -s /etc/nginx/sites-available/timenova.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d timenova.meissasoft.com   # issues cert + adds :443
#
# certbot rewrites this file to add the listen 443 ssl block, the cert paths,
# and an 80->443 redirect. The proxy directives below are inherited into the
# TLS server block by certbot.

# If the host Nginx already defines this map globally, delete these 4 lines.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

upstream letstrack_staging {
  server 127.0.0.1:9001;
  keepalive 32;
}

server {
  listen 80;
  listen [::]:80;
  server_name timenova.meissasoft.com;

  # Screenshot uploads (matches our compose nginx /api/ limit).
  client_max_body_size 20m;

  location / {
    proxy_pass http://letstrack_staging;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;   # becomes https after certbot
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }
}
