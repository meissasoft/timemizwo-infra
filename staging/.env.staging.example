# ============================================================================
# LetsTrack — STAGING environment template.
# Copy to `.env.staging` ON THE SERVER and fill every REQUIRED value.
# NEVER commit .env.staging — only this .example template is tracked.
#
# Two consumers read this file:
#   1) docker compose  — for ${...} interpolation (IMAGE_TAG, ports, passwords)
#   2) the app containers — via `env_file:` (JWT, S3 keys, SMTP, Stripe, …)
#
# NOTE: DATABASE_URL and REDIS_URL are intentionally NOT set here. Compose
# builds them from the parts below (see docker-compose.yml `environment:`),
# because env-file values do not expand nested ${VARS}.
# ============================================================================

# ── Image / ports ───────────────────────────────────────────────────────────
IMAGE_TAG=v0.1.0
# Host loopback port our nginx binds to; the server's Apache/Nginx forwards
# timenova.meissasoft.com -> 127.0.0.1:${PUBLIC_PORT}
PUBLIC_PORT=9001

# ── Postgres (container + DATABASE_URL parts) ────────────────────────────────
POSTGRES_USER=letstrack
POSTGRES_PASSWORD=            # REQUIRED — min 24 chars; avoid @ : / and spaces
POSTGRES_DB=letstrack

# ── Redis (container + REDIS_URL parts) ──────────────────────────────────────
REDIS_PASSWORD=              # REQUIRED — strong random; avoid @ : / and spaces
# Keeps staging keys distinct if a Redis instance is ever shared.
REDIS_KEY_PREFIX=mt-staging:

# ── S3 / MinIO ────────────────────────────────────────────────────────────────
S3_ACCESS_KEY=              # REQUIRED — becomes MINIO_ROOT_USER (min 3 chars)
S3_SECRET_KEY=              # REQUIRED — becomes MINIO_ROOT_PASSWORD (min 8 chars)
S3_BUCKET=letstrack-screenshots
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=                 # REQUIRED — 64+ char random (min 32 enforced)
JWT_ACCESS_TTL=900          # 15 min (seconds)
JWT_REFRESH_TTL=2592000     # 30 days (seconds)
MFA_ISSUER=LetsTrack

# ── Public URL (used inside email links: password reset, invitations) ────────
APP_URL=https://timenova.meissasoft.com

# ── CORS (comma-separated origins) ───────────────────────────────────────────
CORS_ORIGINS=https://timenova.meissasoft.com

# ── Email ──────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=mock          # 'mock' logs emails (no SMTP needed); 'smtp' to really send
EMAIL_FROM=LetsTrack <noreply@meissasoft.com>
# Must be a non-empty hostname even for mock — Joi validates it and an empty
# value fails boot. Put the real SMTP host here when EMAIL_PROVIDER=smtp.
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false      # true for port 465, false for 587 (STARTTLS)
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# ── Billing (Stripe) — leave empty until ready; endpoints return 503 ─────────
# Use TEST keys until real launch. NEVER put live keys in staging.
PLAN_ENFORCEMENT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── AI chat (optional) ───────────────────────────────────────────────────────
AI_PROVIDER=mock

# ── Rate limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Observability (optional) ─────────────────────────────────────────────────
SENTRY_DSN=

# ── Client build-time public vars (baked into the JS bundle at build) ─────────
# Same-origin: the browser hits the same host that served the page. Changing any
# of these requires REBUILDING the client image.
NEXT_PUBLIC_API_URL=https://timenova.meissasoft.com/api
NEXT_PUBLIC_WS_URL=https://timenova.meissasoft.com
NEXT_PUBLIC_APP_URL=https://timenova.meissasoft.com
NEXT_PUBLIC_PRODUCT_NAME=LetsTrack
NEXT_PUBLIC_COMPANY_NAME=Meissasoft

# ── Backups (used by scripts/backup.sh) ──────────────────────────────────────
BACKUP_DIR=/srv/lets-track/backups
BACKUP_RETENTION_DAYS=14
# Off-site target for `rclone copy` (configure the remote first). Leave empty
# to keep local-only backups. Example: BACKUP_REMOTE=r2:letstrack-backups
BACKUP_REMOTE=
